{
  "name": "sloodge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native presentation editor",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.12.0 || >=24.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "oxlint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "_comment": "Partial electron-builder config: M2.4 owns only what the agent needs to work in a packaged app. M5.2 completes it (appId, productName, mac/win/linux targets, icons, signing/notarization, publish). Do not drop these keys when it does.",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "fflate": "catalog:",
    "parse5": "catalog:",
    "pdf-lib": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "~24.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "happy-dom": "^20.11",
    "oxlint": "^1.76",
    "prettier": "^3.9",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
