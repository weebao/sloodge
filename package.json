{
  "name": "sloodge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native presentation editor",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.12.0 || >=24.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "oxlint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:win-paths": "vitest run --config vitest.win32.config.ts",
    "perf:generate": "node perf/bin/generate.mjs",
    "perf:run": "node perf/bin/run.mjs",
    "perf:diff": "node perf/bin/diff.mjs",
    "perf:isolation": "node perf/bin/isolation-probe.mjs",
    "fidelity": "node tests/fidelity/run.ts",
    "pack:dir": "pnpm build && electron-builder --dir",
    "pack:win": "pnpm build && electron-builder --win",
    "pack:win:zip": "pnpm build && electron-builder --win zip",
    "pack:win:release": "pnpm build && electron-builder --win --publish never",
    "pack:mac": "pnpm build && electron-builder --mac"
  },
  "build": {
    "appId": "dev.sloodge.app",
    "productName": "Sloodge",
    "copyright": "Copyright © 2026 Sloodge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "wine": "1.0.1"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ],
    "win": {
      "files": [
        "!**/.vscode/**",
        "!.git",
        "!src/**",
        "!tests/**",
        "!docs/**",
        "!resources/**",
        "!.claude/**",
        "!experiments/**",
        "!electron.vite.config.{js,ts,mjs,cjs}",
        "!vitest.config.{js,ts,mjs,cjs}",
        "!{.editorconfig,.prettierignore,.oxlintrc.json,README.md}",
        "!{.env,.env.*,.npmrc,pnpm-lock.yaml,pnpm-workspace.yaml}",
        "!{tsconfig.json,tsconfig.base.json,tsconfig.node.json,tsconfig.web.json}",
        "!**/node_modules/@anthropic-ai/claude-agent-sdk-{darwin,linux}-*/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sloodge",
      "artifactName": "${name}-${version}-setup.${ext}"
    },
    "mac": {
      "files": [
        "!**/.vscode/**",
        "!.git",
        "!src/**",
        "!tests/**",
        "!docs/**",
        "!resources/**",
        "!.claude/**",
        "!experiments/**",
        "!electron.vite.config.{js,ts,mjs,cjs}",
        "!vitest.config.{js,ts,mjs,cjs}",
        "!{.editorconfig,.prettierignore,.oxlintrc.json,README.md}",
        "!{.env,.env.*,.npmrc,pnpm-lock.yaml,pnpm-workspace.yaml}",
        "!{tsconfig.json,tsconfig.base.json,tsconfig.node.json,tsconfig.web.json}",
        "!**/node_modules/@anthropic-ai/claude-agent-sdk-{linux,win32}-*/**"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "files": [
        "!**/.vscode/**",
        "!.git",
        "!src/**",
        "!tests/**",
        "!docs/**",
        "!resources/**",
        "!.claude/**",
        "!experiments/**",
        "!electron.vite.config.{js,ts,mjs,cjs}",
        "!vitest.config.{js,ts,mjs,cjs}",
        "!{.editorconfig,.prettierignore,.oxlintrc.json,README.md}",
        "!{.env,.env.*,.npmrc,pnpm-lock.yaml,pnpm-workspace.yaml}",
        "!{tsconfig.json,tsconfig.base.json,tsconfig.node.json,tsconfig.web.json}",
        "!**/node_modules/@anthropic-ai/claude-agent-sdk-{darwin,win32}-*/**"
      ]
    },
    "dmg": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "fflate": "catalog:",
    "parse5": "catalog:",
    "pdf-lib": "catalog:",
    "pptxgenjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "~24.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "^20.11",
    "oxlint": "^1.76",
    "prettier": "^3.9",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
