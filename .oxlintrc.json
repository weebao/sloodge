{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "react", "react-perf", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": ["error", "always"],
    "typescript/consistent-type-imports": "error",
    "unicorn/filename-case": "off",
    "unicorn/prefer-node-protocol": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["src/main/**", "src/preload/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/renderer/**", "react", "react-dom", "react-dom/*"],
                "message": "Main and preload must never import renderer code or React."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/renderer/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/main/**", "electron"],
                "message": "The renderer talks to main through the preload IPC contract only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["perf/**"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/main/**", "**/renderer/**", "**/preload/**", "electron", "react"],
                "message": "src/shared must stay dependency-free: types and pure helpers only."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "out", "node_modules", "experiments", ".claude"]
}
